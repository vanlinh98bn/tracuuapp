# Sao chép thành .env rồi điền. KHÔNG đưa file .env lên web hay gửi qua chat.
# Trên Azure App Service: điền các biến này ở Configuration → Application settings.

PORT=3000
# Địa chỉ web người dùng mở (dùng để tạo Redirect URI: <PUBLIC_URL>/auth/callback)
PUBLIC_URL=http://localhost:3000

# PostgreSQL. Azure thêm ?sslmode=require
DATABASE_URL=postgres://postgres@localhost:5499/quyche

# Chuỗi ngẫu nhiên dài (ký cookie đăng nhập). Tạo bằng PowerShell:
#   $b = New-Object byte[] 48; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
SESSION_SECRET=
# Thời hạn phiên: không chọn "Ghi nhớ" / có chọn
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30

# ---- Microsoft 365 (Microsoft Entra ID) – do IT cung cấp ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Chỉ email thuộc các tên miền này được vào (cách nhau bằng dấu phẩy)
ALLOWED_EMAIL_DOMAINS=cattuongnew.vn
# true: nhân viên đăng nhập lần đầu tự có tài khoản quyền "viewer"
# false: HCNS phải thêm email vào bảng users trước
AUTO_CREATE_USERS=true

# Đăng nhập thử không cần Microsoft (chỉ trên localhost, KHÔNG bật trên máy chủ thật)
DEV_LOGIN=false

# ---- File gốc (Word/Excel) để tải về ----
# local: đọc thẳng từ thư mục HCNS · azure: Azure Blob Storage
FILES_DRIVER=local
FILES_DIR=C:\Users\LT_CT\Desktop\HCNS
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=hcns
